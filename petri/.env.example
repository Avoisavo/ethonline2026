# Petri environment.
# Copy this file to .env. Every variable is OPTIONAL.
# With none of them set, Petri runs end to end: `pnpm demo`.
# That is design rule 6. Real mode is the upgrade path, not a mock.

# The Anthropic API key. It lets the harness call a real model.
# WITHOUT IT: `mode` defaults to `replay`. The sandbox still runs for real and the
# tests genuinely execute, but the harness replays recorded or graded answers.
# A replay number can never be compared against a live number.
# WITH IT: `mode` may be `live`, and `petri bench record` can write new fixtures.
ANTHROPIC_API_KEY=

# The Hedera account that pays for topic messages, as "0.0.12345".
# WITHOUT IT: `ledger` defaults to `local`, and the consensus log is
# .petri/log.jsonl. The local log proves authorship and integrity. It proves
# NOTHING about time or non-deletion. The CLI says so in a banner you cannot hide.
# WITH IT: `petri topic create` and `petri anchor` can reach a real topic.
HEDERA_OPERATOR_ID=

# The private key for HEDERA_OPERATOR_ID. DER, ED25519 or ECDSA encoding.
# It is read ONLY from this variable. It is NEVER written to .petri/config.json.
# WITHOUT IT: every write to Hedera fails with a clear error. Reads still work,
# because `petri replay` uses the public mirror node and needs no key at all.
# WITH IT: Petri can submit NodeSubmitted, VerificationSigned and StatusChanged.
HEDERA_OPERATOR_KEY=

# Which Hedera network to use: testnet, mainnet or previewnet.
# WITHOUT IT: Petri uses testnet. Testnet HBAR is free from the portal faucet.
# Set it to mainnet only when you intend to spend real HBAR.
HEDERA_NETWORK=testnet

# The HCS topic that holds this tree, as "0.0.5551234".
# WITHOUT IT: `petri topic create` makes one and writes it into .petri/config.json.
# A topic is created with NO admin key and NO submit key. Nobody can delete or edit
# it, including the person who created it. That is how design rule 3 becomes a
# property of the network instead of a policy.
# SET IT to join a tree somebody else already published.
PETRI_TOPIC_ID=
