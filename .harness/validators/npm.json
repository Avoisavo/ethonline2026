{
  "name": "my-feature-npm",
  "description": "npm commands for this single-package Next.js project. Keep install named \"install\" for fingerprint skip across attempts.",
  "requiresNoSecrets": true,
  "forbiddenCommands": [
    "yarn install",
    "yarn run",
    "pnpm install",
    "pnpm run"
  ],
  "commands": [
    {
      "name": "install",
      "command": "npm install",
      "timeoutMs": 300000,
      "purpose": "Install dependencies."
    },
    {
      "name": "lint",
      "command": "npm run lint",
      "timeoutMs": 180000,
      "purpose": "Lint the project."
    },
    {
      "name": "build",
      "command": "npm run build",
      "timeoutMs": 300000,
      "purpose": "Production build (includes TypeScript checks)."
    }
  ]
}
