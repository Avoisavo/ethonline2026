# Hedera operator — pays for topic creation and message submission.
# Create a testnet account at https://portal.hedera.com
HEDERA_OPERATOR_ID=0.0.12345
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# testnet | mainnet | previewnet
HEDERA_NETWORK=testnet

# Marketplace event log. Create one with:
#   curl -X POST localhost:3000/api/hcs/topics -d '{"memo":"marketplace"}'
MARKETPLACE_TOPIC_ID=0.0.0

# ── Arc (Circle) payments — lib/arc, pages/api/arc, scripts/arc, hardhat/arc ──
# Developer/requester key: funds the escrow fee + acts as the x402 buyer. Also used by hardhat/arc to deploy.
ARC_PRIVATE_KEY=
# Auditor/seller key: posts the bond + receives the settle payout (omit → single-key fallback).
SELLER_PRIVATE_KEY=
# Optional distinct developer key (else ARC_PRIVATE_KEY plays both).
ARC_DEVELOPER_KEY=
# Optional overrides for escrow amounts in USDC base units (default 100000 = 0.1 USDC).
ESCROW_FEE_USDC=
ESCROW_BOND_USDC=
# Optional WalletConnect project id for RainbowKit (injected wallets work without it).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional requester Hedera account for scripts/arc/run-task.ts (else the demo requester).
ARC_AGENT_ID=
# Required for /api/arc/run-task and scripts/arc/run-task.ts (the auditor runs the real OpenAI pipeline).
OPENAI_API_KEY=
# Optional audit model override (default gpt-4o-mini).
OPENAI_MODEL=
# Optional Phala TEE attestor URL (unset → attestation skipped).
PHALA_ATTESTOR_URL=
# Aliases also accepted: DEV_ARC_PRIVATE_KEY (= ARC_DEVELOPER_KEY), AUDITOR_PRIVATE_KEY (= SELLER_PRIVATE_KEY).
# Optional x402 endpoint for scripts/arc/test-x402.ts (default http://localhost:3000/api/arc/skill).
X402_URL=
