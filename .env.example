# Selfie Check is access-gated beta. With these unset, /face runs on the local
# proof engine; set all three and it switches to the real IDKit widget and the
# live verify endpoint with no code change.
#
# All three come from https://developer.world.org — and Selfie Check must be
# enabled for the app itself (request via your World contact), otherwise the
# request fails with `feature_unavailable`.

WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx

# Server-side only. Never prefix with NEXT_PUBLIC_ and never sign in the browser.
WORLD_RP_SIGNING_KEY=0x...

# Must stay STABLE across sessions — nullifiers are scoped per action, so
# rotating this silently destroys the continuity signal.
WORLD_ACTION=continuity-gate

# Optional but recommended: the "Signer address" from World ID Configuration.
# Preflight derives the address from WORLD_RP_SIGNING_KEY and compares, which
# catches a rotated or wrong-app key locally. Without it, a key mismatch only
# ever appears as an opaque `invalid_rp_signature` from World App.
WORLD_RP_SIGNER_ADDRESS=0x...
